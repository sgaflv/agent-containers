#!/usr/bin/env bash

set -euo pipefail

AGENT_NAME="Gemini"

AGENT_IMAGE_NAME="gemini-dev:latest"

SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

AGENT_CONTAINERFILE="$SCRIPT_DIR/Containerfile-gemini"

PROJECT_NAME="$(basename "$(realpath "$(pwd)")")"

CONTAINER_NAME="gemini-${PROJECT_NAME}"

# shellcheck source=run-agent-common.sh

source "$SCRIPT_DIR/run-agent-common.sh"

prepare_persistent_state() {
    mkdir -p "$HOME/.gemini"
    mkdir -p "$HOME/.local/state/gemini"
    mkdir -p "$HOME/.local/share/gemini"
}

run_new_container() {
    exec podman run -it \
        --name "$CONTAINER_NAME" \
        --userns=keep-id \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --network=host \
        -e XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
        -e HOME=/home/agentuser \
        -e XDG_CONFIG_HOME=/home/agentuser/.config \
        -e XDG_DATA_HOME=/home/agentuser/.local/share \
        -e XDG_CACHE_HOME=/home/agentuser/.cache \
        -e ANDROID_HOME=/home/agentuser/Android/Sdk \
        -v "$HOME/.gemini:/home/agentuser/.gemini:rw,Z" \
        -v "$HOME/.local/share/gemini:/home/agentuser/.local/share/gemini:rw,Z" \
        -v "$HOME/.local/state/gemini:/home/agentuser/.local/state/gemini:rw,Z" \
        -v "$PROJECT_DIR:$CONTAINER_PROJECT_DIR:rw,Z" \
        -w "$CONTAINER_PROJECT_DIR" \
        "$AGENT_IMAGE_NAME"
}

run_agent "$@"
